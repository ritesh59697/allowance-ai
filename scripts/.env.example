# Network
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/

# The account the leash contract is deployed on (the agent's account)
LEASH_ACCOUNT=your-leash-account.testnet
# Where `near ... save-to-legacy-keychain` stored the full-access key (default ~/.near-credentials)
# NEAR_CREDENTIALS_DIR=

# Passkey context the contract will accept
PASSKEY_RP_ID=localhost
PASSKEY_ORIGINS=http://localhost:5173

# Owner keys from the approval page (leave empty to use the local dev passkey)
OWNER_PASSKEY_PUBLIC_KEY=
OWNER_RELAY_PUBLIC_KEY=
RELAY_KEY_ALLOWANCE_NEAR=0.5

# Spending policy
POLICY_PER_TX_MAX_NEAR=0.5
POLICY_WINDOW_MAX_NEAR=1
POLICY_WINDOW_SECS=86400
POLICY_MAX_PENDING=10
POLICY_MAX_MEMO_BYTES=140

# Optional agent key installed at deploy time
AGENT_PUBLIC_KEY=
# Gas fee budget for each agent key
AGENT_KEY_ALLOWANCE_NEAR=0.5

GAS_CALL_TGAS=50
GAS_DEPLOY_TGAS=100

# Receiver used by e2e.mjs
E2E_RECEIVER=
