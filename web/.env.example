VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://near-testnet.drpc.org
VITE_NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/
VITE_NEAR_EXPLORER_ACCOUNT_URL=https://testnet.nearblocks.io/address/
# Optional default; the page lets the owner set it
VITE_LEASH_ACCOUNT=
# Defaults to the page's hostname. Must match PASSKEY_RP_ID used at deploy.
VITE_PASSKEY_RP_ID=
# Optional: public repo URL for the landing page and nav (e.g. https://github.com/<you>/<repo>)
VITE_REPO_URL=
VITE_POLL_MS=5000
VITE_GAS_CALL_TGAS=50

# Arena: dev proxy target for /api, and optional API base URL for production builds
ARENA_PROXY_TARGET=http://localhost:8787
VITE_ARENA_API_URL=
VITE_ARENA_POLL_MS=10000
