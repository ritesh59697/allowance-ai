# NEAR
NEAR_RPC_URL=https://near-testnet.drpc.org
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/
LEASH_ACCOUNT=your-leash-account.testnet
# The agent's function-call key (can call agent_spend on LEASH_ACCOUNT only)
AGENT_SECRET_KEY=ed25519:...
GAS_CALL_TGAS=50
NEAR_TIMEOUT_MS=30000
NEAR_RETRIES=3

# LLM: any OpenAI-compatible endpoint. Default: NEAR AI Cloud (https://cloud.near.ai)
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-27B
AGENT_MAX_TURNS=6
LLM_TIMEOUT_MS=60000
# Cap each reply (reasoning models can otherwise think for minutes)
LLM_MAX_TOKENS=2000
LLM_REASONING_EFFORT=low

# Attack scripts
ATTACKER_ACCOUNT=attacker.example.testnet
MERCHANT_ACCOUNT=vendor.example.testnet
DRIP_AMOUNT_NEAR=0.3
DRIP_MAX_ATTEMPTS=10
OTHER_CONTRACT_ACCOUNT=wrap.testnet
# Models to run attack 1 against (comma-separated). The abliterated model has its
# safety training removed (NEAR AI lists it for red teaming) and stands in for a jailbroken agent.
ATTACK_MODELS=Qwen/Qwen3.8-27B,Qwen/Qwen3.8-27B-abliterated

# Arena server (npm run arena)
ARENA_PORT=8787
# Comma-separated origins allowed to call the API from a browser (dev uses the Vite proxy)
ARENA_ALLOWED_ORIGINS=
# Set to 1 only behind a proxy that sets X-Forwarded-For
ARENA_TRUST_PROXY=0
ARENA_RATE_LIMIT_SECONDS=20
ARENA_DAILY_LIMIT=300
ARENA_MAX_MESSAGE_CHARS=1500
ARENA_MAX_QUEUE=5
ARENA_FEED_SIZE=20
ARENA_ATTEMPT_TIMEOUT_MS=150000
ARENA_CHAIN_REFRESH_MS=10000
ARENA_DATA_FILE=data/attempts.jsonl
# Arena difficulty -> model. The jailbroken one has its safety training removed
# (NEAR AI lists it for red teaming); it shows the leash holding even when the AI obeys.
ARENA_MODEL_GUARDED=Qwen/Qwen3.8-27B
ARENA_MODEL_JAILBROKEN=Qwen/Qwen3.8-27B-abliterated
